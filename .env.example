# OpenAI API Key
OPENAI_API_KEY=sk-xxx

# API 代理地址（可选，默认为 OpenAI 官方地址）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7

# Agent Runtime：langgraph（Responses API + checkpoint + HITL）/ legacy（旧 ReAct 循环）
AGENT_RUNTIME=langgraph
# LangGraph SQLite checkpoint；生产环境建议替换为 PostgreSQL checkpointer
LANGGRAPH_CHECKPOINT_PATH=app/sessions/langgraph-checkpoints.sqlite
# postgres 同时启用 checkpoint、API/事件、退款审批和会话/记忆共享存储；sqlite 为本地回退模式
CHECKPOINT_BACKEND=postgres
DATABASE_URL=postgresql:///ecom_service_agent
# 已完成 checkpoint 的保留天数（清理由管理接口/定时任务触发）
CHECKPOINT_RETENTION_DAYS=30
# API 启动及每小时清理已完成的过期 checkpoint，并识别失去执行进程的 run
CHECKPOINT_CLEANUP_INTERVAL_SECONDS=3600
ABANDONED_RUN_SECONDS=300
# 敏感写工具执行前暂停，等待 approve / reject
HITL_ENABLED=true
APPROVAL_TIMEOUT_SECONDS=86400

# 工具可靠性
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=2
TOOL_CIRCUIT_FAILURE_THRESHOLD=3
TOOL_CIRCUIT_RECOVERY_SECONDS=30
TOOL_MAX_INPUT_BYTES=64000
TOOL_MAX_OUTPUT_BYTES=1000000

# 登录凭证：由可信系统配置高熵 token，expires_at 必须是未来的 Unix 秒数。
# 示例结构（不要使用示例 token）：{"<random-token>":{"tenant_id":"tenant-a","user_id":"user-xiaoming","actor_id":"reviewer-1","roles":["approver"],"expires_at":0}}
AUTH_TOKENS={}
REFUND_APPROVER_IDS=[]
# 仅可信身份网关后允许旧版身份 headers；公网默认关闭
TRUSTED_IDENTITY_HEADERS=false
# 网关模式 API 鉴权；必须替换为高熵 Secret
SERVICE_API_KEY=change-me
# 审批与管理使用独立凭证，不能由普通调用方通过角色 header 自行声明
APPROVER_API_KEY=change-me-approver
ADMIN_API_KEY=change-me-admin
# 退款事务与审计数据库（本地 SQLite）
REFUND_DB_PATH=app/sessions/refunds.sqlite
MAX_REFUND_AMOUNT=10000
MAX_REFUNDS_PER_USER_PER_DAY=5
API_SESSION_DB_PATH=app/sessions/api-sessions.sqlite
MAX_CONCURRENT_RUNS=8
# PostgreSQL 模式下该上限跨全部 worker 共享，各实例应使用相同配置

# MCP 配置（第4期）
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Multi-Agent 配置（第6期）
MULTI_AGENT_ENABLED=false

# Memory 配置（第7期）
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skill 配置（第8期）
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation 配置（第9期，离线评估工具）
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6
EVAL_TEMPERATURE=0.0
EVAL_INPUT_COST_PER_MILLION=0.15
EVAL_OUTPUT_COST_PER_MILLION=0.60

# RAG 配置（第5期）
EMBEDDING_MODEL=text-embedding-3-small
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（手写余弦，教学透明）/ chroma（向量数据库，生产代表）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb
