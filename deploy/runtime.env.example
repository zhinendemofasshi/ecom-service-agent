# Copy to runtime.env, chmod 600, then inject real credentials.
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AUTH_TOKENS={}
TRUSTED_IDENTITY_HEADERS=false
REFUND_APPROVER_IDS=[]
CHECKPOINT_BACKEND=sqlite
LANGGRAPH_CHECKPOINT_PATH=app/sessions/langgraph-checkpoints.sqlite
API_SESSION_DB_PATH=app/sessions/api-sessions.sqlite
REFUND_DB_PATH=app/sessions/refunds.sqlite
MEMORY_DIR=app/sessions/memory
MAX_CONCURRENT_RUNS=8
MAX_REACT_STEPS=5
CONTEXT_TOKEN_BUDGET=24000
MCP_ENABLED=false
MCP_TRUSTED_SERVER_URLS=[]
MCP_ALLOWED_TOOLS=[]
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ecom-production
